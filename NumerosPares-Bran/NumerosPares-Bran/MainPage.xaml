<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NumerosPares_Bran.MainPage"
             Title="Números pares">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Image Source="pares.png"
                   HeightRequest="170"
                   Aspect="AspectFit" />

            <Label Text="Números pares del 0 al 100"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Button Text="Mostrar números pares"
                    Clicked="MostrarPares_Clicked"
                    BackgroundColor="SteelBlue"
                    TextColor="White" />

            <Label x:Name="resultado"
                   FontSize="18"
                   TextColor="DarkBlue"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>