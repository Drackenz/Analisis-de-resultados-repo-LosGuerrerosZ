<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SueldoSemanal_Bran.MainPage"
             Title="Sueldo semanal">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Image Source="sueldo.png"
                   HeightRequest="170"
                   Aspect="AspectFit" />

            <Label Text="Calcular sueldo semanal"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Horas trabajadas en la semana:" />

            <Entry x:Name="horas"
                   Placeholder="Ejemplo: 40"
                   Keyboard="Numeric" />

            <Label Text="Pago por cada hora:" />

            <Entry x:Name="pagoHora"
                   Placeholder="Ejemplo: 5.50"
                   Keyboard="Numeric" />

            <Button Text="Calcular sueldo"
                    Clicked="CalcularSueldo_Clicked"
                    BackgroundColor="RoyalBlue"
                    TextColor="White" />

            <Label x:Name="resultado"
                   FontSize="20"
                   TextColor="DarkBlue"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>