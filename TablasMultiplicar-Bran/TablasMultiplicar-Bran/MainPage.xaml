<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TablasMultiplicar_Bran.MainPage"
             Title="Tablas de multiplicar">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Image Source="multiplicar.png"
                   HeightRequest="170"
                   Aspect="AspectFit" />

            <Label Text="Tablas de multiplicar del 1 al 10"
                   FontSize="23"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Button Text="Mostrar tablas"
                    Clicked="MostrarTablas_Clicked"
                    BackgroundColor="MediumSeaGreen"
                    TextColor="White" />

            <Label x:Name="resultado"
                   FontSize="17"
                   TextColor="DarkGreen" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>